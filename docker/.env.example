# ---------------------------------------------------------------------------
# GRC Platform — environment
# Copy to docker/.env (compose) or repo root .env (local dev) and edit.
# ---------------------------------------------------------------------------
NODE_ENV=production
APP_URL=http://localhost:3000
API_PORT=3001
API_URL=http://localhost:3001

# PostgreSQL (docker compose service names: grc-db / grc-redis)
DATABASE_URL=postgresql://grc:grc@grc-db:5432/grc?schema=public
POSTGRES_USER=grc
POSTGRES_PASSWORD=grc
POSTGRES_DB=grc

# Session signing
JWT_SECRET=change-me-super-secret-jwt-key
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Authentication method: none | account | keycloak
#   none     = dashboard fully open, no login at all
#   account  = single account defined by ACCOUNT_LOGIN / ACCOUNT_PASSWORD
#   keycloak = OpenID Connect (Authorization Code + PKCE) with an allow list
# ---------------------------------------------------------------------------
AUTH_METHOD=account

# Account auth settings (used when AUTH_METHOD=account)
ACCOUNT_LOGIN=admin@example.com
ACCOUNT_PASSWORD=admin123

# Google reCAPTCHA (login form and the public subscription form) is configured
# in the dashboard: Admin > Settings > "Login protection". Use a reCAPTCHA v3
# (score based) key pair - a v2 pair answers "Invalid key type" - and set the
# minimum score there (0.1-0.9, default 0.5). Both keys or neither; an empty
# pair keeps the captcha off. The RECAPTCHA_CLIENTID and RECAPTCHA_CLIENTSECRET
# variables were removed when the keys moved into the settings table, and a
# leftover value is ignored (the boot logs a warning).

# ---------------------------------------------------------------------------
# Keycloak / OIDC auth settings (used when AUTH_METHOD=keycloak)
# ---------------------------------------------------------------------------
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=up-realm
KEYCLOAK_CLIENT_ID=up-client
KEYCLOAK_CLIENT_SECRET=YOURSECRET
# Leave empty to derive it automatically as ${APP_URL}/api/auth/callback
KEYCLOAK_REDIRECT_URI=
# Where the identity provider sends the browser back after a logout. Leave it
# empty to derive ${APP_URL}/login. Register the resulting URL in the client
# (Client > Login settings > Valid post logout redirect URIs), otherwise the
# provider answers the logout with "Invalid redirect uri".
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=
# Allow list checked against the e-mail returned by the identity provider.
# Space separated entries; each entry can be an exact address or a domain
# (@empresa.com, empresa.com and domain2.com are all accepted).
KEYCLOAK_ACCOUNTS=admin@example.com @empresa.com domain2.com

# ---------------------------------------------------------------------------
# Internationalization
# ---------------------------------------------------------------------------
DEFAULT_LOCALE=en-US

# ---------------------------------------------------------------------------
# File storage: local | s3  (S3 works with AWS, MinIO, R2, Wasabi)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/storage/app
STORAGE_MAX_FILE_MB=50
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=grc
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Jobs (optional — falls back to inline execution when empty)
# ---------------------------------------------------------------------------
REDIS_URL=redis://grc-redis:6379

# ---------------------------------------------------------------------------
# Email (notifications). Leave SMTP_HOST empty to log e-mails instead.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GRC Platform <no-reply@grc.local>"

# ---------------------------------------------------------------------------
# AI assistant (OpenAI compatible) — optional
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Seed demo companies/users/data on first boot (true|false)
SEED_DEMO=true
